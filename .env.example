# XCrystal Server Configuration
# Copy this file to .env and modify as needed

# Laya model path (required for server.py and helper scripts)
# Local directory, or a Hugging Face repo id that laya.load accepts
# (e.g. convaiinnovations/laya or convaiinnovations/laya-multilingual)
LAYA_MODEL_PATH=/path/to/laya/multilingual

# Virtualenv used by ./start.sh (env VENV_PATH overrides this)
VENV_PATH=.venv

# Server host and port
SERVER_HOST=127.0.0.1
SERVER_PORT=5678

# Cache settings
CACHE_SIZE=1000

# Log file path (relative to server directory)
LOG_FILE=server.log

# URL preprocessing before inference: domain | remove | off
# domain replaces each URL with "[link: example.com]"; remove strips URLs entirely.
# Bare 0x / Solana addresses in plain text are kept (not treated as URLs).
URL_PREPROCESS=remove

# If relevance stays below this after scope gating, treat as gated (irrelevant).
LOW_RELEVANCE_GATE=0.35

# Optional device override for laya.load (passed as device=...).
# Leave unset to let laya auto-pick (MPS on Apple Silicon, CUDA if available, else CPU).
# Examples when you need to force a device: mps | cuda | cpu
# LAYA_DEVICE=mps

# Mark direction as uncertain when max direction probability is below this (open interval (0,1)).
# Default 0.60. Grey "uncertain" / 不确定 in the extension when below the threshold.
UNCERTAIN_THRESHOLD=0.60
